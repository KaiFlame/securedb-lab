{
  "products": {
    "bsonType": "object",
    "additionalProperties": false,
    "required": [
      "_id",
      "tenant_id",
      "name",
      "sku",
      "category",
      "price_cents",
      "active"
    ],
    "properties": {
      "_id": {
        "bsonType": "string",
        "pattern": "^[a-f0-9-]{36}$"
      },
      "tenant_id": {
        "bsonType": "string",
        "pattern": "^[a-f0-9-]{36}$"
      },
      "name": {
        "bsonType": "string",
        "minLength": 3,
        "maxLength": 100
      },
      "active": {
        "bsonType": "bool"
      },
      "sku": {
        "bsonType": "string",
        "pattern": "^[A-Z0-9-]{3,32}$"
      },
      "category": {
        "enum": [
          "Equipamentos",
          "Software",
          "Serviços"
        ]
      },
      "price_cents": {
        "bsonType": "int",
        "minimum": 1,
        "maximum": 100000000
      }
    }
  },
  "profiles": {
    "bsonType": "object",
    "additionalProperties": false,
    "required": [
      "_id",
      "tenant_id",
      "name",
      "email",
      "segment",
      "active"
    ],
    "properties": {
      "_id": {
        "bsonType": "string",
        "pattern": "^[a-f0-9-]{36}$"
      },
      "tenant_id": {
        "bsonType": "string",
        "pattern": "^[a-f0-9-]{36}$"
      },
      "name": {
        "bsonType": "string",
        "minLength": 3,
        "maxLength": 100
      },
      "active": {
        "bsonType": "bool"
      },
      "email": {
        "bsonType": "string",
        "maxLength": 150,
        "pattern": "^[A-Za-z0-9_.+-]+@example\\.test$"
      },
      "segment": {
        "enum": [
          "Essencial",
          "Corporativo",
          "Estratégico"
        ]
      }
    }
  }
}